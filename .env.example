# 复制为 .env 后填入真实值。`.env` 已在 .gitignore 中，切勿提交。
# 凭据留空即可跑离线测试；只有真实调用链路与 MCP 工具需要填。

# ====== 服务 ======
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8001
CORS_ORIGINS=http://localhost:5173

# ====== 模型底座（与 agent-harness 共用同一组环境变量）======
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-seed-2-0-pro-260215

QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_API_KEY=
ALIBABA_API_KEY=
QWEN_MODEL=qwen-plus

DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 多模态视觉（可选）
DASHSCOPE_API_KEY=
VISION_MODEL=qwen-vl-plus

# ====== 检索中间件 ======
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=document_chunks

ES_HOST=localhost
ES_PORT=9200
ES_INDEX=document_chunks

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ====== 向量与切片 ======
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-base
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=10
RERANK_TOP_K=5

# ====== 联网搜索（可选）======
SERPAPI_KEY=
BING_API_KEY=
SEARCH_ENGINE=google

# ====== 业务后端 / MCP 工具鉴权 ======
JAVA_API_URL=http://localhost:8080/api
MCP_JWT_TOKEN=

# ====== MCP 工具服务（src/agentic_rag/mcp_server）======
# 默认端口与 AI 服务同为 8001，同机并跑时任改其一
MCP_HOST=0.0.0.0
MCP_PORT=8001
# 留空即 fail-closed：外部调用一律 401/403。生成：openssl rand -hex 32
MCP_API_KEY=

# ====== 调度网关开关（默认关，弱网与离线测试可稳定跑）======
ENABLE_NLI=False
ENABLE_MOA=False

# ====== 可观测（可选）======
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
MONITOR_MAX_TRACES=1000
